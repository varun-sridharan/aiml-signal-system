+# WHAT: the note a retried unit carries, and nothing else changes in the grader's instructions.
+# CONCEPT: eval — bounded retry (bk-retry). A verdict whose claims were copied out of the SOURCE
+# rather than read off the WRITING was derived from the wrong document, and is the one signature
+# the 2026-09-15 baseline found on the unit carrying a missed plant. The note names the claims
+# that gave it away and restates the one rule the system prompt already has, so the retry is a
+# fresh derivation and not the same answer twice. The system prompt is not edited: the first
+# pass of every run, and the clean-day baseline, are exactly what they were.
+RETRY_NOTE = (
+    "RETRY. Your previous verdict for this unit listed claims that appear word for word in the excerpt "
+    "but are not what `writing_under_test` says, so they were read off the excerpt and not off the writing. "
+    "Do it again from the writing only. Read `writing_under_test` sentence by sentence; for each checkable "
+    "statement it makes, phrase the claim the way the WRITING words it (its verbs, its subjects, its figures), "
+    "then look for a span of the excerpt that says the same thing, and mark it unsupported if the excerpt says "
+    "something different about that subject, even when the same figure or name appears there. "
+    "Claims copied from your previous verdict, which must not be repeated: "
+)
+
+
+def _unit_payload(raw_day: dict, framing: dict, unit_id: str, lifted: list) -> dict:
+    """The grader's payload for ONE unit: the item alone, or the thread alone, plus the retry note."""
+    if unit_id == "thread":
+        # The thread is graded against every excerpt, so all of them go; no item's writing does.
+        payload = build_check_payload(raw_day, {**framing, "items": []})
+    else:
+        one = {**raw_day, "items": [i for i in raw_day["items"] if i["id"] == unit_id]}
+        payload = build_check_payload(one, {"items": [f for f in framing["items"] if f["id"] == unit_id],
+                                            "thread": "", "threadSplit": None})
+    payload["_retry"] = RETRY_NOTE + json.dumps(lifted, ensure_ascii=False)
+    return payload
+
+
+def _add_usage(a, b):
+    """Token counts of two calls, summed, in the shape estimate_cost_usd reads."""
+    fields = ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
+    return SimpleNamespace(**{f: (getattr(a, f, 0) or 0) + (getattr(b, f, 0) or 0) for f in fields})
